df main() -> void {
    fixed a: [i8; 3] = [-5, 100, -128];
    fixed b: [u8; 3] = [200, 255, 0];
    fixed c: [i16; 2] = [-300, 30000];
    fixed d: [u32; 2] = [4000000000, 7];
    fixed e: [u64; 2] = [9000000000, 1];
    fixed f: [f64; 2] = [1.5, -2.25];
    fixed g: [bool; 2] = [true, false];
    echo!(fmt("i8={a[0]} u8={b[0]} i16={c[0]} u32={d[0]} u64={e[0]} f64={f[1]} bool={g[0]}"));
}

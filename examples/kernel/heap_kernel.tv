// A freestanding kernel that uses HEAP types, via the allocator hook.
// Bump allocator over a fixed physical region - no OS, no libc.
fixed ARENA_BASE: i64 = 2097152;
fixed ARENA_SIZE: i64 = 1048576;
set arena_off: i64 = 0;

df on_alloc(size: i64) -> varda<u8> {
    set n: i64 = size;
    fixed rem: i64 = n - ((n / 16) * 16);
    check rem != 0 { n = n + (16 - rem); }
    check arena_off + n > ARENA_SIZE {
        unsafe set nul: varda<u8> = from_addr(0);
        return nul;
    }
    fixed at: i64 = ARENA_BASE + arena_off;
    arena_off = arena_off + n;
    unsafe set p: varda<u8> = from_addr(at);
    return p;
}

df on_free(p: varda<u8>) -> void {
}

df main() -> void {
    // i128 is heap-boxed, so this allocates through the hook.
    set big: i128 = 170141183460469231731687303715884105727;
    set two: i128 = 2;
    fixed diff: i128 = big - two;
    unsafe set vga: varda<u16> = from_addr(753664);
    unsafe store_vol(vga, 3912);
    whilst true {
        unsafe hlt();
    }
}

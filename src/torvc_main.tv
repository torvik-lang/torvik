// torvc_main.tv -  full self-hosting Torvik compiler 

apply torvik_lexer;
apply torvik_parser;
apply torvik_codegen;
apply diag;

// v1.5.3: an argument forwarded to a program under `torvc run` is refused when it
// contains shell syntax.
//
// The command line is handed to a shell, and double-quoting an argument stops
// word-splitting but NOT command substitution - "$(...)" and backticks still
// expand inside quotes. `torvc run` is reachable from scripts and CI where the
// arguments come from data rather than from someone typing, so this is a real
// trust boundary. Refusing is the same fix the --arch and --link-lib
// vulnerabilities needed.
df run_arg_ok(a: str) -> i64 {
    set i: i64 = 0;
    whilst i < len(a) {
        fixed c: i64 = byte_at(a, i);
        check c == 36 || c == 96 || c == 34 || c == 92 { return 0; }
        check c == 59 || c == 124 || c == 38 { return 0; }
        check c == 60 || c == 62 || c == 10 || c == 13 { return 0; }
        i += 1;
    }
    return 1;
}

df is_version_arg(c: str) -> i64 {
    check c == "version" { return 1; }
    check c == "--version" { return 1; }
    check c == "-V" { return 1; }
    return 0;
}

df is_help_arg(c: str) -> i64 {
    check c == "help" { return 1; }
    check c == "--help" { return 1; }
    check c == "-h" { return 1; }
    return 0;
}

df main() -> void {
    fixed argc: i64 = args();
    check argc < 2 {
        print_version();
        echo!("");
        print_help();
        exit(0);
    }
    fixed first: str = args_get(1);
    fixed vf: i64 = is_version_arg(first);
    check vf == 1 { print_version(); exit(0); }
    fixed hf: i64 = is_help_arg(first);
    check hf == 1 { print_help(); exit(0); }

    // v1.5.0: mode selection. `-o` anywhere => BUILD (emit a binary, existing
    // behavior). No `-o` => RUN (python3-style: compile + execute, no binary left).
    // Internal tooling (fixpoint, rune) always passes -o, so it stays in build mode.
    set has_o: i64 = 0;
    set oj: i64 = 1;
    whilst oj < argc { check args_get(oj) == "-o" { has_o = 1; } oj += 1; }

    check has_o == 0 {
        // RUN mode:  torvc [flags] script.tv [program args...]
        // Flags recognized before the script; the first .tv is the script; every
        // token after it is forwarded verbatim to the program (even .tv data files).
        set r_verbose: i64 = 0;
        set r_script: str = "";
        set r_sidx: i64 = 0;
        set rr: i64 = 1;
        whilst rr < argc && len(r_script) == 0 {
            fixed ra: str = args_get(rr);
            check ra == "-v" || ra == "--verbose" { r_verbose = 1; } fallback {
                check ra == "--no-warn" { warn_suppress = 1; } fallback {
                    check ends(ra, ".tv") { r_script = ra; r_sidx = rr; }
                }
            }
            rr += 1;
        }
        check len(r_script) == 0 {
            echo!("torvc: no source file given (try 'torvc --help')"); exit(1);
        }
        set prog_argv: list<str> = list_new();
        set pa: i64 = r_sidx + 1;
        whilst pa < argc { push(prog_argv, args_get(pa)); pa += 1; }
        run_file(r_script, prog_argv, r_verbose);
        exit(0);
    }

    set srcfile: str = "";
    set outpath: str = "";
    set verbose: i64 = 0;
    set quiet: i64 = 0;
    set final: i64 = 0;
    set i: i64 = 1;
    whilst i < argc {
        fixed a: str = args_get(i);
        check a == "-o" {
            check i + 1 < argc { outpath = args_get(i + 1); i += 1; }
        } fallback {
            check a == "--entry" {
                check i + 1 < argc {
                    fixed _te: str = args_get(i + 1);
                    check entry_symbol_ok(_te) == 0 {
                        echo!(fmt("torvc: '{}' is not a usable entry symbol name.", _te));
                        echo!("  The entry symbol is emitted directly into LLVM IR, so it follows C");
                        echo!("  identifier rules: a letter or underscore, then letters, digits or");
                        echo!("  underscores.");
                        exit(1);
                    }
                    g_build_entry = _te;
                    i += 1;
                }
            } fallback {
                check a == "--arch" || a == "--target" {
                    check i + 1 < argc {
                        fixed _ta: str = args_get(i + 1);
                        check build_triple_ok(_ta) == 0 {
                            echo!(fmt("torvc: '{}' is not a usable target triple.", _ta));
                            echo!("  The triple is passed to clang as `-target <triple>`, so it is limited to");
                            echo!("  letters, digits, and _ . - ; anything else is refused rather than handed");
                            echo!("  to a shell. This value can come from torvik.rune, which means it can come");
                            echo!("  from a repository you only cloned.");
                            exit(1);
                        }
                        g_build_arch = _ta;
                        i += 1;
                    }
                } fallback {
                    check a == "--link-script" {
                        check i + 1 < argc { g_build_linkscript = args_get(i + 1); i += 1; }
                    } fallback {
                      check a == "--elf32" { g_build_elf32 = 1; } fallback {
                      check a == "--link-with" {
                        check i + 1 < argc { g_build_linkwith = args_get(i + 1); i += 1; }
                      } fallback {
                        check a == "--bare" { g_build_bare = 1; no_std_flag = 1; } fallback {
                            check a == "--no-std" { no_std_flag = 1; } fallback {
                                check a == "-v" || a == "--verbose" { verbose = 1; } fallback {
                                    check a == "-q" || a == "--quiet" { quiet = 1; } fallback {
                                        check a == "--final" { final = 1; } fallback {
                                            check a == "--no-warn" { warn_suppress = 1; } fallback {
                                                check ends(a, ".tv") { check len(srcfile) == 0 { srcfile = a; } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                      }
                      }
                    }
                }
            }
        }
        i += 1;
    }
    // v1.5.0 Forge F6: hand the freestanding settings to codegen before it runs.
    set_bare_mode(g_build_bare, g_build_entry);
    check len(srcfile) == 0 {
        echo!("torvc: no source file given (try 'torvc --help')"); exit(1);
    }
    // v1.1.3: when -o is omitted, derive the output name from the source file
    // (basename minus .tv, in the current directory; +.exe on Windows), as
    // TOOLING.md documents. Previously the binary silently went to ~/tv_out.
    check len(outpath) == 0 {
        set base: str = srcfile;
        set bi: i64 = len(base) - 1;
        whilst bi >= 0 {
            fixed bc: str = char_at(base, bi);
            check bc == "/" || bc == "\\" { base = substr(base, bi + 1, len(base)); bi = 0 - 1; } fallback { bi -= 1; }
        }
        check ends(base, ".tv") { base = substr(base, 0, len(base) - 3); }
        check len(base) == 0 { base = "tv_out"; }
        check line_eq(sys_os_name(), "windows") == 1 { base = str_concat(base, ".exe"); }
        outpath = base;
    }
    compile_file(srcfile, outpath, verbose, quiet, final);
}

df resolve_asset(devpath: str, name: str) -> str {
    fixed devfull: str = str_concat(devpath, name);
    check fs_exists(devfull) == 1 { return devfull; }
    return str_concat(str_concat(sys_home_dir(), "/.torvik/lib/"), name);
}

// The scratch directory where torvc writes the generated IR and the compiled
// runtime object. On POSIX this is /tmp/.torvik; on Windows /tmp rarely exists,
// so use %TEMP%\.torvik (falling back to the user profile). Created with the
// native fs_mkdir (no shell), so it works identically on every platform.
df torvik_build_dir() -> str {
    check line_eq(sys_os_name(), "windows") == 1 {
        fixed tmp: str = readenv("TEMP");
        check len(tmp) > 0 { return str_concat(tmp, "\\.torvik"); }
        return str_concat(sys_home_dir(), "\\.torvik");
    }
    return "/tmp/.torvik";
}

// Path join with the platform separator (Windows accepts '/', but native '\\'
// keeps command lines clean for cmd.exe).
df torvik_path_join(dir: str, leaf: str) -> str {
    check line_eq(sys_os_name(), "windows") == 1 { return str_concat(dir, str_concat("\\", leaf)); }
    return str_concat(dir, str_concat("/", leaf));
}

// clang is a required external dependency on every platform. `clang --version`
// returns 0 when clang is on PATH and non-zero otherwise, and works in both a
// POSIX shell and cmd.exe (unlike `command -v`, which is shell-only). Output is
// silenced per-platform.
df clang_present() -> i64 {
    check line_eq(sys_os_name(), "windows") == 1 {
        return sys_run("clang --version > NUL 2>&1");
    }
    return sys_run("clang --version > /dev/null 2>&1");
}

df ver_match(line: str, key: str) -> str {
    fixed t: str = trim(line);
    fixed kl: i64 = len(key);
    check len(t) > kl {
        check starts(t, key) {
            fixed after: i64 = byte_at(t, kl);
            check after == 32 || after == 61 || after == 9 {
                set j: i64 = kl;
                whilst j < len(t) {
                    check byte_at(t, j) == 61 { return trim(substr(t, j + 1, len(t))); }
                    j += 1;
                }
            }
        }
    }
    return "";
}

df ver_field(content: str, key: str) -> str {
    set found: str = "";
    set buf: str = "";
    set i: i64 = 0;
    fixed n: i64 = len(content);
    whilst i < n {
        fixed c: i64 = byte_at(content, i);
        check c == 10 {
            check len(found) == 0 { fixed v: str = ver_match(buf, key); check len(v) > 0 { found = v; } }
            buf = "";
        } fallback {
            buf = str_concat(buf, substr(content, i, i + 1));
        }
        i += 1;
    }
    check len(found) == 0 { fixed v2: str = ver_match(buf, key); check len(v2) > 0 { found = v2; } }
    return found;
}

df version_of(key: str) -> str {
    // Only trust a VERSION file in the current directory if it is actually Torvik's
    // (it names the key we're asking for). Plenty of projects keep their own VERSION
    // file, and one of those used to shadow the toolchain's - `torvc --version` then
    // reported 0.0.0 from inside any such directory.
    fixed content: str = readfile(resolve_asset("./", "VERSION"));
    fixed v: str = ver_field(content, key);
    check len(v) > 0 { return v; }
    fixed installed: str = str_concat(sys_home_dir(), "/.torvik/lib/VERSION");
    check diag_path_exists(installed) == 1 {
        fixed v2: str = ver_field(readfile(installed), key);
        check len(v2) > 0 { return v2; }
    }
    return "0.0.0";
}

df print_version() -> void {
    echo!(str_concat(str_concat("torvik v", version_of("torvik")), str_concat(" / torvc v", version_of("torvc"))));
    // v1.5.0: the standard library ships from its own repository and records its
    // version in lib/std.VERSION, not in Torvik's VERSION.
    set _sv: str = "";
    fixed _svp: str = resolve_asset("./", "std.VERSION");
    check diag_path_exists(_svp) == 1 { _sv = ver_field(readfile(_svp), "std"); }
    check len(_sv) > 0 {
        echo!(str_concat("std v", _sv));
    } fallback {
        echo!("std  not installed");
    }
}

df print_help() -> void {
    echo!("torvc - the Torvik compiler");
    echo!("");
    echo!("USAGE:");
    echo!("  torvc <file.tv> [args...]                    Run a Torvik file (compile + execute)");
    echo!("  torvc <file.tv> -o <out> [-v] [--final]      Compile a Torvik file to a binary");
    echo!("  torvc version | --version | -V              Show version");
    echo!("  torvc help | --help | -h                    Show this help");
    echo!("");
    echo!("RUN vs BUILD:");
    echo!("  With no -o, torvc runs the file directly (python3-style) and leaves no binary.");
    echo!("  Any tokens after the file are passed to the program as arguments, readable with");
    echo!("  args() / args_get(i)  (e.g. `torvc scan.tv a.txt b.txt`).");
    echo!("  With -o, torvc compiles to that binary instead of running.");
    echo!("");
    echo!("FLAGS:");
    echo!("  -v, --verbose   Show compile details (bytes, tokens, IR path)");
    echo!("  -q, --quiet     Suppress build output except diagnostics (errors and warnings)");
    echo!("  --final         Production build (-O3, stripped)");
    echo!("  --no-warn       Suppress compile warnings (they never fail the build; -q does NOT imply this - warnings are diagnostics)");
}

// Scan for an unterminated string literal. Returns the 0-based offset of the
// opening quote of the first string with no closing quote, or -1 if all strings
// are balanced. Mirrors the lexer: skips // comments, honors backslash escapes.
// True for characters that may appear in an identifier.
df ident_char(c: i64) -> i64 {
    check is_alpha(c) { return 1; }
    check is_digit(c) { return 1; }
    check c == 95 { return 1; }
    return 0;
}

// Single source-ordered pass that collects ALL of the source-level errors we
// can detect before lexing — unterminated string literals and function
// declarations missing their parameter list — pushing each (offset, message)
// onto the parallel out-lists. Skips // comments. After an unterminated string
// it resumes past that line so later errors are still reported.
df collect_source_errors(source: str, offs: list<i64>, msgs: list<str>) -> void {
    fixed n: i64 = len(source);
    set pos: i64 = 0;
    whilst pos < n {
        fixed c: i64 = byte_at(source, pos);
        check c == 47 && pos + 1 < n && byte_at(source, pos + 1) == 47 {
            pos += 2;
            whilst pos < n && byte_at(source, pos) != 10 { pos += 1; }
            continue;
        }
        // Block comment #- ... -# (nestable). Skip its body; report an opener
        // that never balances. Checked before strings so a quote inside a
        // comment can't start a phantom string literal.
        check c == 35 && pos + 1 < n && byte_at(source, pos + 1) == 45 {
            fixed bopen_at: i64 = pos;
            pos += 2;
            set bdepth: i64 = 1;
            whilst pos < n && bdepth > 0 {
                fixed bce: i64 = byte_at(source, pos);
                check bce == 35 && pos + 1 < n && byte_at(source, pos + 1) == 45 { bdepth += 1; pos += 2; continue; }
                check bce == 45 && pos + 1 < n && byte_at(source, pos + 1) == 35 { bdepth -= 1; pos += 2; continue; }
                pos += 1;
            }
            check bdepth > 0 {
                push(offs, bopen_at);
                push(msgs, "unterminated block comment (missing closing -#)");
            }
            continue;
        }
        // A stray terminator with no matching opener. `#` is never valid in
        // Torvik code, so `-#` outside a comment or string is always this error.
        check c == 45 && pos + 1 < n && byte_at(source, pos + 1) == 35 {
            push(offs, pos);
            push(msgs, "found a block comment terminator '-#' with no opening '#-'");
            pos += 2;
            continue;
        }
        check c == 34 || c == 39 {
            set q: i64 = c;
            fixed open_at: i64 = pos;
            pos += 1;
            set closed: i64 = 0;
            whilst pos < n {
                fixed ch: i64 = byte_at(source, pos);
                check ch == 92 { pos += 2; continue; }
                check ch == 10 { break; }
                check ch == q { closed = 1; pos += 1; break; }
                pos += 1;
            }
            check closed == 0 {
                push(offs, open_at);
                push(msgs, "unterminated string literal (missing closing quote)");
                whilst pos < n && byte_at(source, pos) != 10 { pos += 1; }
            }
            continue;
        }
        // v1.2.0: a numeric literal with TWO decimal points ("0.1.0") is not a
        // number - it reads like a version string, and previously produced a
        // confusing cascade of parse errors. Report it cleanly, once, with the
        // fix. A range like 0..5 has no digit between the dots and never
        // matches; the scan consumes the whole malformed run so nothing
        // downstream trips over its tail.
        check c >= 48 && c <= 57 {
            set prev_id: i64 = 0;
            check pos > 0 && ident_char(byte_at(source, pos - 1)) == 1 { prev_id = 1; }
            check pos > 0 && byte_at(source, pos - 1) == 46 { prev_id = 1; }
            check prev_id == 0 {
                fixed num_at: i64 = pos;
                set q2: i64 = pos;
                set dots: i64 = 0;
                set go2: i64 = 1;
                whilst go2 == 1 {
                    check q2 >= n { go2 = 0; }
                    check go2 == 1 {
                        fixed dc: i64 = byte_at(source, q2);
                        check dc >= 48 && dc <= 57 { q2 += 1; continue; }
                        check dc == 46 && q2 + 1 < n && byte_at(source, q2 + 1) >= 48 && byte_at(source, q2 + 1) <= 57 {
                            dots += 1; q2 += 2; continue;
                        }
                        go2 = 0;
                    }
                }
                check dots >= 2 {
                    push(offs, num_at);
                    push(msgs, fmt("'{}' is not a number - a float has a single decimal point. For a version string, use quotes: \"{}\"", substr(source, num_at, q2), substr(source, num_at, q2)));
                    pos = q2;
                    continue;
                }
            }
        }
        // 'df' as a whole word: 'd','f', non-identifier on both sides.
        check c == 100 && pos + 1 < n && byte_at(source, pos + 1) == 102 {
            set prev_ok: i64 = 1;
            check pos > 0 && ident_char(byte_at(source, pos - 1)) == 1 { prev_ok = 0; }
            set after_ok: i64 = 0;
            check pos + 2 < n && ident_char(byte_at(source, pos + 2)) == 0 { after_ok = 1; }
            check prev_ok == 1 && after_ok == 1 {
                set q: i64 = pos + 2;
                set go: i64 = 1;
                whilst go == 1 {
                    check q >= n { go = 0; }
                    check go == 1 {
                        fixed wc: i64 = byte_at(source, q);
                        check wc == 32 || wc == 9 || wc == 10 || wc == 13 { q += 1; } fallback { go = 0; }
                    }
                }
                fixed name_start: i64 = q;
                whilst q < n && ident_char(byte_at(source, q)) == 1 { q += 1; }
                fixed name_end: i64 = q;
                set go2: i64 = 1;
                whilst go2 == 1 {
                    check q >= n { go2 = 0; }
                    check go2 == 1 {
                        fixed wc2: i64 = byte_at(source, q);
                        check wc2 == 32 || wc2 == 9 || wc2 == 10 || wc2 == 13 { q += 1; } fallback { go2 = 0; }
                    }
                }
                check name_end > name_start {
                    check q < n && byte_at(source, q) != 40 {
                        push(offs, name_end);
                        push(msgs, "expected '(' after function name - a function needs a parameter list, e.g. df name() -> type { ... }");
                    }
                }
                pos = q;
                continue;
            }
        }
        pos += 1;
    }
}

// ── Module import resolution ─────────────────────────────────────────────────
// Imports are declared with `apply` directives at the top of a file:
//   apply name;            -> include src/name.tv (project module), falling back
//                             to the installed library dir (std + Rune libraries)
//   apply name::func;      -> same file; selective scoping is reserved for a
//   apply name::{a, b};      later release, so the whole module is included now
//   apply extern "path";   -> include a .tv file by path, outside of src/
// Resolution is recursive (a module's own imports are pulled in first, so
// dependencies precede dependents) and de-duplicated by resolved path, so the
// same module is never emitted twice no matter how many files import it. A file
// with no `apply` directives — any ordinary user program — gets nothing prepended.

df import_seen(seen: list<str>, path: str) -> i64 {
    set i: i64 = 0;
    whilst i < len(seen) {
        check line_eq(seen[i], path) == 1 { return 1; }
        i += 1;
    }
    return 0;
}

df is_name_char(c: i64) -> i64 {
    check c >= 48 && c <= 57 { return 1; }
    check c >= 65 && c <= 90 { return 1; }
    check c >= 97 && c <= 122 { return 1; }
    check c == 95 { return 1; }
    return 0;
}

// Resolve one `base::item` reference to a file path and append it to `out`.
// A submodule file (base/item.tv) wins; otherwise the whole module (base.tv) is
// used, so the reserved `name::func` selective form still pulls in name.tv.
// `apply std...` is hard-refused when the project is built with no_std.
df add_import(out: list<str>, base: str, item: str, no_std: i64) -> void {
    check no_std == 1 && line_eq(base, "std") == 1 {
        check g_build_bare == 1 {
            echo!("torvc: `apply std` is disabled - this is a freestanding build (--bare).");
            echo!("  The standard library assumes an operating system underneath it.");
        } fallback {
            check no_std_flag == 1 {
                echo!("torvc: `apply std` is disabled - this build passed --no-std.");
            } fallback {
                echo!("torvc: `apply std` is disabled - torvik.rune sets std = no_std");
            }
        }
        exit(1);
    }
    check len(item) > 0 {
        fixed subp: str = resolve_asset("./src/", str_concat(base, str_concat("/", str_concat(item, ".tv"))));
        check fs_exists(subp) == 1 { push(out, subp); return; }
    }
    fixed _modp: str = resolve_asset("./src/", str_concat(base, ".tv"));
    check fs_exists(_modp) == 1 { } fallback {
        echo!(str_concat(str_concat("torvc: error: unknown module '", base), "' - no matching .tv file found in ./src or ~/.torvik/lib"));
        exit(1);
    }
    push(out, _modp);
}

// Parse a single trimmed `apply ...` line into zero or more resolved file paths.
df resolve_import_paths(ln: str, no_std: i64, out: list<str>) -> void {
    check starts(ln, "apply extern ") {
        set q1s: i64 = 0;       whilst q1s < len(ln) && byte_at(ln, q1s) != 34 { q1s += 1; }
        set q1e: i64 = q1s + 1; whilst q1e < len(ln) && byte_at(ln, q1e) != 34 { q1e += 1; }
        check q1e < len(ln) { push(out, substr(ln, q1s + 1, q1e)); }
        return;
    }
    check starts(ln, "apply ") {
        fixed rest: str = substr(ln, 6, len(ln));
        set j: i64 = 0;
        whilst j < len(rest) && is_name_char(byte_at(rest, j)) == 1 { j += 1; }
        fixed base: str = substr(rest, 0, j);
        check len(base) == 0 { return; }
        // plain `apply base;`?
        check j + 1 >= len(rest) || byte_at(rest, j) != 58 || byte_at(rest, j + 1) != 58 {
            add_import(out, base, "", no_std);
            return;
        }
        // `apply base::...`
        fixed after: str = substr(rest, j + 2, len(rest));
        check starts(after, "{") {
            // brace list: base::{a, b, c}
            set ke: i64 = 1; whilst ke < len(after) && byte_at(after, ke) != 125 { ke += 1; }
            fixed inner: str = substr(after, 1, ke);
            fixed items: list<str> = split(inner, ",");
            set k: i64 = 0;
            whilst k < len(items) {
                fixed it: str = trim(items[k]);
                check len(it) > 0 { add_import(out, base, it, no_std); }
                k += 1;
            }
            return;
        }
        // single item: base::item
        set m: i64 = 0;
        whilst m < len(after) && is_name_char(byte_at(after, m)) == 1 { m += 1; }
        add_import(out, base, substr(after, 0, m), no_std);
        return;
    }
}

// Read the project's std policy from torvik.rune (in the working directory).
// Returns 1 when the manifest sets `std = no_std`, disabling the standard library
// project-wide; 0 when there is no manifest or std is enabled.
df project_no_std() -> i64 {
    check fs_exists("torvik.rune") == 0 { return 0; }
    fixed content: str = readfile("torvik.rune");
    fixed lines: list<str> = split(content, "\n");
    set i: i64 = 0;
    whilst i < len(lines) {
        fixed t: str = trim(lines[i]);
        check starts(t, "std") && str_contains(t, "no_std") { return 1; }
        i += 1;
    }
    return 0;
}

df build_prelude(source: str, seen: list<str>, no_std: i64) -> str {
    set prelude: str = "";
    fixed lines: list<str> = split(source, "\n");
    set i: i64 = 0;
    whilst i < len(lines) {
        fixed ln: str = trim(lines[i]);
        set paths: list<str> = list_new();
        resolve_import_paths(ln, no_std, paths);
        set pi: i64 = 0;
        whilst pi < len(paths) {
            fixed incpath: str = paths[pi];
            check import_seen(seen, incpath) == 0 {
                push(seen, incpath);
                fixed dep_src: str = readfile(incpath);
                check len(dep_src) == 0 {
                    echo!(str_concat("torvc: cannot resolve import -> ", incpath));
                    exit(1);
                }
                // dependency-first: the module's own imports, then the module
                prelude = str_concat(prelude, build_prelude(dep_src, seen, no_std));
                prelude = str_concat(prelude, dep_src);
            }
            pi += 1;
        }
        i += 1;
    }
    return prelude;
}

// v1.5.0 Forge F6: freestanding build options, set from the command line in main()
// and read by compile_file when it links. Kept as globals so the compile_file
// signature (also used by run mode) stays unchanged.
set g_build_bare: i64 = 0;
set no_std_flag: i64 = 0;
set g_build_entry: str = "_start";
set g_build_linkscript: str = "";
// Extra sources/objects to compile and link into a freestanding image - typically a
// boot stub in assembly that the Torvik side cannot express (32-bit entry code,
// descriptor tables, a long-mode switch).
set g_build_linkwith: str = "";
// Multiboot 1 loaders (GRUB, QEMU -kernel) require a 32-bit ELF container, even for a
// kernel whose code is 64-bit. Set by --elf32.
set g_build_elf32: i64 = 0;
set g_build_arch: str = "x86_64-unknown-none-elf";

// v1.5.0: every path handed to clang goes through here. Unquoted, a directory with
// a space ("My Documents", "Program Files") split into two arguments and the build
// died with clang "no such file or directory" behind an internal TVC-5002 - and an
// unquoted path interpolated into a shell command is the classic injection shape
// that static analysis (rightly) flags. Double quotes work for both POSIX sh and
// cmd.exe. Any embedded double quote is dropped rather than escaped: no legitimate
// build path contains one, and dropping it cannot create a new argument boundary.
df shq(pth: str) -> str {
    set clean: str = "";
    set i: i64 = 0;
    whilst i < len(pth) {
        fixed c: i64 = byte_at(pth, i);
        check c != 34 { clean = str_concat(clean, substr(pth, i, i + 1)); }
        i += 1;
    }
    return str_concat(str_concat("\"", clean), "\"");
}

// Silence a probe command on either shell. `>/dev/null 2>&1` is meaningless to
// cmd.exe, which printed "The system cannot find the path specified." and left the
// exit status useless - so the probe reported the wrong answer on Windows.
df probe_cmd(c: str) -> str {
    check line_eq(sys_os_name(), "windows") == 1 { return str_concat(c, " >NUL 2>&1"); }
    return str_concat(c, " >/dev/null 2>&1");
}

df compile_file(path: str, out: str, verbose: i64, quiet: i64, final: i64) -> void {
    // A missing input file is a user error, not a toolchain fault — give a clean
    // message instead of letting readfile raise a runtime panic.
    check diag_path_exists(path) == 0 {
        echo!(str_concat(str_concat("torvc: cannot open '", path), "' - no such file"));
        exit(1);
    }
    fixed source: str = readfile(path);
    fixed _t_build0: i64 = time_ms();
    fixed slen: i64   = len(source);
    check slen == 0 { echo!("torvc: file is empty or could not be read - nothing to compile"); exit(1); }
    set err_offs: list<i64> = list_new();
    set err_msgs: list<str> = list_new();
    collect_source_errors(source, err_offs, err_msgs);
    check len(err_offs) > 0 {
        set ei: i64 = 0;
        whilst ei < len(err_offs) {
            render_source_error(source, path, err_offs[ei], err_msgs[ei]);
            echo!("");
            ei += 1;
        }
        echo!(fmt("{} error(s) found.", len(err_offs)));
        exit(1);
    }

    // clang is a required external dependency; a missing clang is an environment
    // problem, not a Torvik bug. Detect it here so the TVC-5001/5002 internal codes
    // are reserved for genuine compiler/linker failures.
    check clang_present() != 0 {
        echo!("torvc: clang not found in PATH - Torvik needs clang to compile.");
        echo!("  install clang (your distribution's 'clang' package, or LLVM for Windows) and try again.");
        exit(1);
    }

    check verbose == 1 {
        echo!(str_concat("-- Compiling ", path));
        echo!(str_concat("   ", str_concat(int_to_str(slen), " bytes")));
    }

    set import_seen_set: list<str> = list_new();
    // --no-std (and --bare, which implies it) force no_std regardless of manifest.
    set no_std: i64 = project_no_std();
    check no_std_flag == 1 { no_std = 1; }
    fixed prelude: str = build_prelude(source, import_seen_set, no_std);
    fixed combined:  str = str_concat(prelude, source);
    // v1.2.1: record where the user's own text begins so diagnostics report
    // the user's real line numbers (see render_source_diag).
    diag_user_start = len(prelude);
    set _plc: i64 = 0;
    set _pli: i64 = 0;
    whilst _pli < len(prelude) {
        check byte_at(prelude, _pli) == 10 { _plc += 1; }
        _pli += 1;
    }
    diag_prelude_lines = _plc;

    fixed tokens: list<i64> = lex_source(combined);
    fixed ntok: i64 = len(tokens);
    check verbose == 1 { echo!(str_concat("   ", str_concat(int_to_str(ntok), " tokens"))); }

    fixed build_dir: str = torvik_build_dir();
    fs_mkdir(build_dir);
    fixed ir_path: str = torvik_path_join(build_dir, "torvik_compile.ll");
    fixed rt_obj:  str = torvik_path_join(build_dir, "torvik_runtime.o");
    codegen_tokens(tokens, combined, ir_path, path);
    // Safety net: codegen always writes IR for a well-formed program. A missing IR
    // file means codegen bailed without emitting — an internal fault distinct from
    // "clang rejected the IR" (TVC-5002). Catch it as a coded internal error.
    check diag_path_exists(ir_path) == 0 {
        internal_error("TVC-9001", "codegen", path, "code generation produced no IR output");
    }
    check verbose == 1 { echo!(str_concat("   IR -> ", ir_path)); }

    fixed rt_src: str = resolve_asset("./runtime/", "torvik_runtime.c");
    // v1.5.0 Forge F6: freestanding build. There is no libc and no hosted runtime
    // here, so the bundled runtime C is not compiled or linked at all. The target
    // is decided by the TARGET triple, never by the build host — a kernel built on
    // Windows is the same ELF as one built on Linux — so the hosted Windows/GNU
    // branch below must not run. -nostdlib drops crt/libc, -ffreestanding tells
    // clang not to assume library semantics, and the entry symbol comes from
    // --entry (default _start). An optional linker script places the sections.
    check g_build_bare == 1 {
        set bare_ld: str = "";
        check len(g_build_linkscript) > 0 {
            check diag_path_exists(g_build_linkscript) == 0 {
                echo!(fmt("torvc: link script '{}' not found.", g_build_linkscript));
                exit(1);
            }
            bare_ld = str_concat(str_concat(" -T ", shq(g_build_linkscript)), " ");
        }
        set bare_opt: str = "-O2";
        check final == 1 { bare_opt = "-O3"; }
        // Axis A: if the program defines the allocator hooks, compile the Torvik
        // runtime freestanding and link it, so heap types work bare. Per-function
        // sections plus --gc-sections are what make this practical - they drop every
        // runtime function the program never reaches, which is the difference between
        // a couple of undefined symbols and dozens (sockets, stdio, ctype, errno).
        // Extra object/source (a boot stub, say). Assembled or compiled for the same
        // target, then linked alongside the Torvik code.
        set bare_extra: str = "";
        check len(g_build_linkwith) > 0 {
            check diag_path_exists(g_build_linkwith) == 0 {
                echo!(fmt("torvc: --link-with file '{}' not found.", g_build_linkwith));
                exit(1);
            }
            fixed ext_obj: str = torvik_path_join(torvik_build_dir(), "torvik_linkwith.o");
            fixed ext_cmd: str = str_concat(str_concat(str_concat(str_concat("clang -target ", g_build_arch), " -ffreestanding -mno-red-zone -c "), shq(g_build_linkwith)), str_concat(" -o ", shq(ext_obj)));
            check verbose == 1 { echo!(str_concat("   LINK-WITH -> ", ext_cmd)); }
            fixed ext_rc: i64 = sys_run(ext_cmd);
            check ext_rc != 0 {
                echo!(fmt("torvc: could not build '{}' for this target.", g_build_linkwith));
                exit(1);
            }
            bare_extra = str_concat(" ", shq(ext_obj));
        }
        set bare_rt: str = "";
        check g_bare_alloc_hooks == 1 {
            fixed brt_obj: str = torvik_path_join(torvik_build_dir(), "torvik_runtime_bare.o");
            // v1.5.0: compiled for the TARGET, not the host. torvik_runtime.c has a
            // TORVIK_BARE path that skips every hosted header and declares what little
            // it needs by hand, so a bare triple resolves cleanly. This is what makes a
            // freestanding build genuinely host-independent: on Windows the host
            // toolchain would otherwise emit a COFF object, which cannot link into an
            // ELF kernel. --gc-sections then drops every function the program never
            // reaches, so the OS-dependent parts are absent from the image entirely.
            fixed brt_cmd: str = str_concat(str_concat(str_concat(str_concat("clang -target ", g_build_arch), " -ffreestanding -DTORVIK_BARE -mno-red-zone -ffunction-sections -fdata-sections -Wno-override-module -c "), shq(rt_src)), str_concat(" -o ", shq(brt_obj)));
            check verbose == 1 { echo!(str_concat("   BARE-RT -> ", brt_cmd)); }
            fixed brt_rc: i64 = sys_run(brt_cmd);
            check brt_rc != 0 {
                echo!("torvc: could not compile the Torvik runtime for a freestanding target.");
                echo!("  Defining on_alloc/on_free pulls the runtime into a bare build so that heap");
                echo!("  types work. Remove the hooks and the runtime is left out entirely.");
                exit(1);
            }
            bare_rt = str_concat(" ", shq(brt_obj));
        }
        // When a link script is supplied it carries ENTRY(...), which is the more
        // specific statement of intent - passing -e as well just invites the two to
        // disagree silently.
        // Windows: clang defaults to the MinGW/COFF linker driver, which rejects the
        // ELF objects a bare build produces ("unknown file type"). LLVM's linker
        // handles ELF on every host, and llvm-mingw bundles it. Use it when present -
        // but only then, since a plain Linux clang may have no lld installed and the
        // system linker works fine there.
        set have_lld: i64 = 0;
        check sys_run(probe_cmd("ld.lld --version")) == 0 { have_lld = 1; }
        set bare_entry_flag: str = str_concat(" -Wl,-e,", g_build_entry);
        check len(g_build_linkscript) > 0 { bare_entry_flag = ""; }
        // Compile the IR to an object of its own. Doing this as a separate step lets
        // the LINK be handled by ld.lld directly below - going through the clang
        // driver on Windows routed the link via gcc/MinGW, which then handed ELF
        // objects to a linker expecting COFF ("unknown file type").
        fixed ir_obj: str = torvik_path_join(torvik_build_dir(), "torvik_bare_ir.o");
        fixed irc_cmd: str = str_concat(str_concat(str_concat(str_concat(str_concat("clang -target ", g_build_arch), " "), bare_opt), str_concat(" -ffreestanding -fno-stack-protector -fno-pic -mno-red-zone -Wno-override-module -c ", shq(ir_path))), str_concat(" -o ", shq(ir_obj)));
        check verbose == 1 { echo!(str_concat("   BARE-IR -> ", irc_cmd)); }
        check sys_run(irc_cmd) != 0 {
            echo!("torvc: could not compile the generated IR for this target.  [TVC-6001]");
            echo!(fmt("  target: {}", g_build_arch));
            exit(1);
        }

        set bare_cmd: str = "";
        check have_lld == 1 {
            // The LLVM linker handles ELF on every host, and llvm-mingw bundles it.
            // Invoking it directly keeps the platform's own linker driver out of the
            // way entirely, which is what makes a bare build behave the same on
            // Windows as on Linux.
            set lld_ent: str = str_concat(" -e ", g_build_entry);
            check len(g_build_linkscript) > 0 { lld_ent = ""; }
            set lld_ld: str = "";
            check len(g_build_linkscript) > 0 { lld_ld = str_concat(" -T ", shq(g_build_linkscript)); }
            bare_cmd = str_concat(str_concat(str_concat(str_concat("ld.lld -m elf_x86_64 --gc-sections", lld_ent), lld_ld), str_concat(" ", str_concat(shq(ir_obj), str_concat(bare_rt, bare_extra)))), str_concat(" -o ", shq(out)));
        } fallback {
            // No lld: fall back to the platform toolchain. Fine on Linux, where the
            // system linker reads ELF natively.
            bare_cmd = str_concat(str_concat(str_concat(str_concat(str_concat("clang -target ", g_build_arch), " -ffreestanding -nostdlib -static -fno-pic -Wno-override-module -Wl,--gc-sections"), bare_entry_flag), str_concat(bare_ld, str_concat(" ", str_concat(shq(ir_obj), str_concat(bare_rt, bare_extra))))), str_concat(" -o ", shq(out)));
        }
        check verbose == 1 { echo!(str_concat("   BARE -> ", bare_cmd)); }
        fixed bare_rc: i64 = sys_run(bare_cmd);
        check bare_rc == 0 {
            // Multiboot 1 hands control to the kernel in 32-bit mode and, less
            // obviously, refuses to load a 64-bit ELF at all - QEMU says "Cannot load
            // x86-64 image, give a 32bit one". The CODE stays 64-bit; only the ELF
            // container is rewritten, which is safe because the link is already
            // complete and every relocation resolved.
            check g_build_elf32 == 1 {
                set oc: str = "llvm-objcopy";
                check sys_run(probe_cmd("llvm-objcopy --version")) != 0 { oc = "objcopy"; }
                // objcopy must not be given the same path for input and output - it
                // truncates the file and you are left with a success message and no
                // binary. Write beside it, then move into place.
                fixed oc_tmp: str = str_concat(out, ".elf32.tmp");
                fixed oc_cmd: str = str_concat(str_concat(str_concat(oc, " -O elf32-i386 "), shq(out)), str_concat(" ", shq(oc_tmp)));
                check verbose == 1 { echo!(str_concat("   ELF32 -> ", oc_cmd)); }
                set oc_rc: i64 = sys_run(oc_cmd);
                check oc_rc == 0 {
                    set mv_cmd: str = str_concat(str_concat("mv -f ", shq(oc_tmp)), str_concat(" ", shq(out)));
                    check line_eq(sys_os_name(), "windows") == 1 {
                        mv_cmd = str_concat(str_concat("move /Y ", shq(oc_tmp)), str_concat(" ", str_concat(shq(out), " >NUL")));
                    }
                    check sys_run(mv_cmd) != 0 { oc_rc = 1; }
                }
                check oc_rc != 0 {
                    echo!("torvc: could not rewrite the image as a 32-bit ELF.");
                    echo!("  --elf32 needs llvm-objcopy or objcopy on PATH. Without it the image is");
                    echo!("  still a valid 64-bit freestanding ELF - it just won't load via Multiboot 1.");
                    exit(1);
                }
            }
            check quiet == 0 { echo!(fmt("Forged freestanding image! ({})", diag_fmt_secs(time_ms() - _t_build0))); }
            return;
        }
        echo!("torvc: the freestanding link failed.  [TVC-6001]");
        echo!(fmt("  target: {}   entry: {}", g_build_arch, g_build_entry));
        echo!("  A bare build links no libc and no Torvik runtime, so any call that needs");
        echo!("  either shows up here as an undefined symbol. Common causes:");
        echo!("    - a heap type (str/list/table/bag) without the on_alloc/on_free hooks");
        echo!("    - a linker script that doesn't define the sections your target needs");
        echo!("    - lld not installed (bare linking uses the LLVM linker)");
        exit(1);
    }
    // On Windows, target the GNU (mingw) toolchain explicitly. Without this,
    // clang defaults to the MSVC target and needs Visual Studio's headers/libs;
    // the GNU target uses the mingw-w64 headers and libs that ship with the
    // recommended Windows toolchain (LLVM-MinGW / MSYS2). On Linux and macOS the
    // native default target is correct, so no flag is added.
    set tgt: str = "";
    check line_eq(sys_os_name(), "windows") == 1 { tgt = " -target x86_64-w64-windows-gnu "; }
    fixed rt_compile: str = str_concat(str_concat(str_concat(str_concat("clang", tgt), " -Wno-override-module -ffunction-sections -fdata-sections -c "), shq(rt_src)), str_concat(" -o ", shq(rt_obj)));
    fixed rt_result: i64 = sys_run(rt_compile);
    check rt_result != 0 {
        // On Windows the usual cause is a clang install without the mingw-w64
        // headers/libs (e.g. plain LLVM), so the GNU target can't find stdio.h.
        // That's an environment problem, not a Torvik bug — guide the user rather
        // than emitting the internal TVC-5001 "please report" code.
        check line_eq(sys_os_name(), "windows") == 1 {
            echo!("torvc: could not compile the bundled runtime.");
            echo!("  On Windows, Torvik needs a clang that includes the MinGW-w64 C headers and");
            echo!("  libraries (plain LLVM alone does not). Install one of these, then retry:");
            echo!("    - LLVM-MinGW:  https://github.com/mstorsjo/llvm-mingw/releases");
            echo!("    - MSYS2:       install msys2, then `pacman -S mingw-w64-clang-x86_64-toolchain`");
            echo!("    - WinLibs:     https://winlibs.com  (UCRT build, add its bin to PATH)");
            echo!("  Make sure the toolchain's bin directory is on your PATH (so clang finds its headers).");
            exit(1);
        }
        internal_error("TVC-5001", "runtime-build", path, "bundled runtime C failed to compile (clang error)");
    }

    // Link flags differ by platform. Dead-section stripping uses --gc-sections on
    // GNU/ELF (and lld on Windows) and Mach-O's -dead_strip on macOS; the release
    // symbol-strip is -s on ELF. We keep the portable subset per platform.
    set optflags: str = "-O2";
    set gcflag: str = " -Wl,--gc-sections ";
    set stripflag: str = "";
    // On Windows, suppress the PE header timestamp so identical inputs link to
    // byte-identical .exe files (reproducible builds). Without this, two links of
    // the same IR differ only in the embedded build time, which makes a
    // self-hosting fixpoint report a false "binaries differ".
    set reproflag: str = "";
    check line_eq(sys_os_name(), "windows") == 1 { reproflag = " -Wl,--no-insert-timestamp "; }
    // std::net's socket primitives need Winsock at link time on Windows; POSIX
    // sockets are in libc, so no extra library elsewhere.
    set libflags: str = "";
    check line_eq(sys_os_name(), "windows") == 1 { libflags = " -lws2_32 "; }
    check line_eq(sys_os_name(), "macos") == 1 {
        gcflag = " -Wl,-dead_strip ";
        check final == 1 { optflags = "-O3"; }
    } fallback {
        check final == 1 { optflags = "-O3"; stripflag = " -Wl,-s "; }
    }
    fixed cmd: str = str_concat(str_concat(str_concat(str_concat(str_concat(str_concat(str_concat(str_concat("clang", tgt), " "), str_concat(optflags, " -Wno-override-module")), gcflag), stripflag), reproflag), str_concat(shq(ir_path), str_concat(" ", str_concat(shq(rt_obj), libflags)))), str_concat(" -o ", shq(out)));
    fixed result: i64 = sys_run(cmd);
    check result == 0 {
        check verbose == 1 { echo!(str_concat("   BIN -> ", out)); }
        check quiet == 0 { echo!(fmt("Compiled successfully! ({})", diag_fmt_secs(time_ms() - _t_build0))); }
    } fallback {
        // Inline assembly is the one place a user can hand the backend text the
        // compiler cannot validate. If this module used galdr, blame the assembly
        // rather than telling the user to file a toolchain bug.
        check g_used_galdr == 1 {
            echo!("torvc: the assembler rejected this build.");
            echo!("  This program contains `galdr { ... }` inline assembly, which torvc passes");
            echo!("  through untouched - so the instruction text itself is the likely cause.");
            echo!("  Check the mnemonics and operand syntax (AT&T form, e.g. `mov $1, %rax`),");
            echo!("  and that every instruction is a separate string.");
            exit(1);
        }
        internal_error("TVC-5002", "ir-build", path, "clang rejected generated IR or linking failed");
    }
}

// v1.5.0: run mode. Compile the script to a throwaway binary and execute it
// immediately, python3-style, forwarding any extra arguments to the program (so
// `torvc scan.tv a.txt b.txt` gives the program argv = [bin, a.txt, b.txt], which
// it reads with the usual file builtins). No binary is left in the user's tree.
// The temp binary lives under ~/.torvik/run (an executable location — /tmp is
// mounted noexec on some systems, so the build dir there can't be run from).
df run_file(script: str, prog_argv: list<str>, verbose: i64) -> void {
    fixed home: str = sys_home_dir();
    set rundir: str = str_concat(home, "/.torvik/run");
    check line_eq(sys_os_name(), "windows") == 1 { rundir = str_concat(home, "\\.torvik\\run"); }
    // Create the run directory, and make sure it actually exists before compiling
    // into it. The very first `rune run` on a machine was failing while every later
    // one worked - a fresh-directory race. A shell mkdir is idempotent and creates
    // parents, so it costs nothing to be certain here.
    fs_mkdir(rundir);
    check fs_exists(rundir) == 0 {
        set mk: str = str_concat("mkdir -p ", shq(rundir));
        check line_eq(sys_os_name(), "windows") == 1 {
            mk = str_concat(str_concat("if not exist ", shq(rundir)), str_concat(" mkdir ", shq(rundir)));
        }
        sys_run(mk);
    }
    check fs_exists(rundir) == 0 {
        echo!(fmt("torvc: could not create the run directory '{}'.", rundir));
        echo!("  Run mode compiles to a throwaway binary there. Build with -o instead,");
        echo!("  or check the permissions on your Torvik home.");
        exit(1);
    }
    fixed pid: i64 = sys_pid();
    set binname: str = str_concat("tvrun_", int_to_str(pid));
    check line_eq(sys_os_name(), "windows") == 1 { binname = str_concat(binname, ".exe"); }
    fixed binpath: str = torvik_path_join(rundir, binname);
    // Compile quietly (no "Compiled successfully" banner in run mode); compile
    // errors and warnings still print, and a hard error still exits non-zero.
    compile_file(script, binpath, verbose, 1, 0);
    // Build: "binpath" "arg1" "arg2" ...  (each token quoted so paths with spaces
    // survive the shell on both POSIX sh and cmd.exe).
    set cmd: str = str_concat("\"", str_concat(binpath, "\""));
    set k: i64 = 0;
    whilst k < len(prog_argv) {
        check run_arg_ok(prog_argv[k]) == 0 {
            echo!(fmt("torvc: the argument '{}' cannot be passed to a program under `torvc run`.", prog_argv[k]));
            echo!("  It contains shell syntax, and the argument is handed to a shell to start");
            echo!("  the program. Quoting does not make this safe - command substitution still");
            echo!("  expands inside quotes - so it is refused. Compile the program with -o and");
            echo!("  run it directly if you need to pass an argument like this.");
            exit(1);
        }
        cmd = str_concat(cmd, str_concat(" \"", str_concat(prog_argv[k], "\"")));
        k += 1;
    }
    // Same cmd.exe quirk as in rune: a command that begins and ends with a quote has
    // that outer pair stripped, mangling the line. Give cmd a spare pair to remove.
    set runcmd: str = cmd;
    check line_eq(sys_os_name(), "windows") == 1 {
        runcmd = str_concat(str_concat("\"", cmd), "\"");
    }
    fixed code: i64 = sys_run(runcmd);
    // Best-effort cleanup; the run dir stays but never accumulates (pid-named).
    fs_remove(binpath);
    exit(code);
}
